{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "dev-nexus/academy-api",
  "type": "project",
  "description": "Laravel API for the Arabic Dev Nexus Academy platform.",
  "license": "MIT",
  "authors": [
    {
      "name": "Jamal Abu Attaya",
      "homepage": "https://jamalabuattaya-portfolio.netlify.app"
    }
  ],
  "require": {
    "php": "^8.4",
    "laravel/framework": "^13.0",
    "laravel/sanctum": "^4.0",
    "laravel/tinker": "^3.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "laravel/pail": "^1.2",
    "laravel/pint": "^1.26",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": { "Tests\\": "tests/" }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php artisan migrate --graceful --ansi"
    ],
    "serve": ["@php artisan serve --host=127.0.0.1 --port=8000"],
    "test": ["@php artisan test"],
    "check": [
      "@php artisan optimize:clear",
      "@php artisan test"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": { "pestphp/pest-plugin": true, "php-http/discovery": true }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
