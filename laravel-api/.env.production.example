APP_NAME="Dev Nexus Academy API"
APP_ENV=production
APP_KEY=base64:generate-a-real-key-before-deploying
APP_DEBUG=false
APP_URL=https://api.your-domain.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_URL=postgresql://username:password@host:5432/database

CACHE_STORE=file
SESSION_DRIVER=file
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=sync

FRONTEND_URLS=https://your-project.vercel.app
SANCTUM_STATEFUL_DOMAINS=your-project.vercel.app

YOUTUBE_API_KEY=
RUN_MIGRATIONS=true
RUN_SEEDERS=false
