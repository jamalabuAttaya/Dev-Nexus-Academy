# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/laravel-api/.phpunit.result.cache

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment files
.env*
!.env.example
!.env.production.example
!laravel-api/.env.example
!laravel-api/.env.production.example

# Deployment output
.vercel

# typescript
*.tsbuildinfo
/dist/
/outputs/
/work/

# Laravel
/laravel-api/vendor/
/laravel-api/.env
/laravel-api/database/*.sqlite
/laravel-api/storage/logs/*.log
/laravel-api/bootstrap/cache/*.php

# Editors
/.idea/
/.vscode/
